{
  "name": "lucid-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hostable authentication and authorization for Cloudflare Workers, with passkeys, OAuth, secure sessions, RBAC, and a developer dashboard.",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply lucid-auth --local",
    "db:migrate:remote": "wrangler d1 migrations apply lucid-auth --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "jose": "6.2.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.4",
    "@cloudflare/workers-types": "5.20261117.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.164.0"
  }
}
